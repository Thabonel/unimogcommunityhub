# WIS Guacamole Environment Configuration
# Copy this file to .env and update with your production values

# Database Configuration
GUACAMOLE_DB_PASSWORD=your_secure_database_password_here

# SSL Configuration (paths relative to nginx/ssl/ directory)
SSL_CERT_PATH=wis.unimogcommunityhub.com.crt
SSL_KEY_PATH=wis.unimogcommunityhub.com.key

# Domain Configuration
WIS_DOMAIN=wis.unimogcommunityhub.com
WIS_SERVER_HOST=wis-server.unimogcommunityhub.com

# Session Configuration
MAX_SESSION_DURATION=14400  # 4 hours in seconds
MAX_IDLE_TIME=1800          # 30 minutes in seconds
CLEANUP_INTERVAL=300        # 5 minutes in seconds

# Security Configuration
RATE_LIMIT=10               # Requests per minute per IP
ENABLE_RECORDING=true       # Enable session recording

# Monitoring Configuration
LOG_LEVEL=info
HEALTH_CHECK_INTERVAL=30    # seconds

# Network Configuration
GUACAMOLE_NETWORK=172.20.0.0/16