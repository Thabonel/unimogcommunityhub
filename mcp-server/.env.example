# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anonymous-key-here

# Optional: Service role key for signing private storage URLs
# OPTIONAL_SERVICE_ROLE=your-service-role-key-here

# Server Configuration
STORAGE_SIGN_TTL_SEC=300
QUERY_TIMEOUT_MS=15000
LOG_LEVEL=info

# Optional: Bearer token for MCP authentication
# OPTIONAL_BEARER_TOKEN=your-bearer-token-here

# Deployment
PORT=3000