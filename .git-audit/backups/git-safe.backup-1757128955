#!/bin/bash
# Git-Safe: Corruption Prevention Wrapper for Git Operations
# Version: 1.0.0
# Usage: git-safe <git-command> [args...]

set -euo pipefail

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
LOCK_FILE="${REPO_ROOT}/.git/git-safe.lock"
LOG_FILE="${REPO_ROOT}/.git/git-safe.log"
BACKUP_DIR="${REPO_ROOT}/.git/git-safe-backups"
CONFIG_FILE="${REPO_ROOT}/.git/git-safe.conf"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[${timestamp}] [${level}] ${message}" >> "${LOG_FILE}"
    
    case "${level}" in
        "ERROR")
            echo -e "${RED}[ERROR]${NC} ${message}" >&2
            ;;
        "WARN")
            echo -e "${YELLOW}[WARN]${NC} ${message}" >&2
            ;;
        "INFO")
            echo -e "${BLUE}[INFO]${NC} ${message}"
            ;;
        "SUCCESS")
            echo -e "${GREEN}[SUCCESS]${NC} ${message}"
            ;;
        *)
            echo "${message}"
            ;;
    esac
}

# Load configuration
load_config() {
    # Default configuration
    ENABLE_BACKUPS=true
    ENABLE_INTEGRITY_CHECKS=true
    ENABLE_CORRUPTION_DETECTION=true
    MAX_BACKUPS=10
    RISKY_OPERATIONS="rebase|reset|gc|filter-branch|rewrite"
    QUICK_CHECK_OPERATIONS="commit|push|pull|merge|checkout"
    
    # Load user configuration if exists
    if [[ -f "${CONFIG_FILE}" ]]; then
        source "${CONFIG_FILE}"
    fi
}

# Initialize git-safe system
initialize() {
    if [[ ! -d "${REPO_ROOT}/.git" ]]; then
        log "ERROR" "Not in a git repository"
        exit 1
    fi
    
    # Create necessary directories
    mkdir -p "${BACKUP_DIR}"
    
    # Create log file if it doesn't exist
    touch "${LOG_FILE}"
    
    # Create default config if it doesn't exist
    if [[ ! -f "${CONFIG_FILE}" ]]; then
        cat > "${CONFIG_FILE}" << 'EOF'
# Git-Safe Configuration
ENABLE_BACKUPS=true
ENABLE_INTEGRITY_CHECKS=true
ENABLE_CORRUPTION_DETECTION=true
MAX_BACKUPS=10
RISKY_OPERATIONS="rebase|reset|gc|filter-branch|rewrite"
QUICK_CHECK_OPERATIONS="commit|push|pull|merge|checkout"
EOF
    fi
    
    log "INFO" "Git-Safe initialized in $(basename "${REPO_ROOT}")"
}

# Acquire exclusive lock (cross-platform)
acquire_lock() {
    local timeout=300  # 5 minutes timeout
    local counter=0
    
    log "INFO" "Acquiring git-safe lock..."
    
    # Cross-platform locking mechanism
    while true; do
        # Try to create lock file atomically
        if (set -C; echo "$$:$(date):$(whoami):$*" > "${LOCK_FILE}") 2>/dev/null; then
            break
        fi
        
        if [[ $counter -ge $timeout ]]; then
            log "ERROR" "Timeout waiting for git-safe lock after ${timeout} seconds"
            log "ERROR" "If you're sure no other git operation is running, remove: ${LOCK_FILE}"
            exit 1
        fi
        
        # Check if existing lock is stale (older than 1 hour)
        if [[ -f "${LOCK_FILE}" ]]; then
            local lock_age
            if command -v stat >/dev/null 2>&1; then
                if stat -f%m "${LOCK_FILE}" >/dev/null 2>&1; then
                    # macOS stat
                    local lock_time=$(stat -f%m "${LOCK_FILE}")
                    local current_time=$(date +%s)
                    lock_age=$((current_time - lock_time))
                else
                    # Linux stat
                    local lock_time=$(stat -c%Y "${LOCK_FILE}")
                    local current_time=$(date +%s)
                    lock_age=$((current_time - lock_time))
                fi
                
                # Remove stale locks (older than 1 hour)
                if [[ $lock_age -gt 3600 ]]; then
                    log "WARN" "Removing stale lock file (${lock_age}s old)"
                    rm -f "${LOCK_FILE}"
                    continue
                fi
            fi
        fi
        
        if [[ $((counter % 10)) -eq 0 ]]; then
            log "WARN" "Waiting for other git operation to complete... (${counter}s)"
        fi
        
        sleep 1
        ((counter++))
    done
    
    log "INFO" "Lock acquired (PID: $$)"
}

# Release lock
release_lock() {
    if [[ -f "${LOCK_FILE}" ]]; then
        rm -f "${LOCK_FILE}"
        log "INFO" "Lock released"
    fi
}

# Cleanup function
cleanup() {
    local exit_code=$?
    release_lock
    if [[ $exit_code -ne 0 ]]; then
        log "ERROR" "Git operation failed with exit code: $exit_code"
    fi
    exit $exit_code
}

# Check repository integrity
check_integrity() {
    local quick_check="$1"
    
    log "INFO" "Checking repository integrity..."
    
    if [[ "${quick_check}" == "true" ]]; then
        # Quick check for frequent operations
        if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
            log "ERROR" "Repository HEAD is corrupted"
            return 1
        fi
        
        if ! git status --porcelain >/dev/null 2>&1; then
            log "ERROR" "Repository index is corrupted"
            return 1
        fi
    else
        # Full integrity check for risky operations
        log "INFO" "Running git fsck for integrity check..."
        if git fsck --no-progress 2>/dev/null; then
            log "SUCCESS" "Full integrity check passed"
        else
            log "ERROR" "Repository integrity check failed"
            log "WARN" "Run 'git fsck --full' for detailed analysis"
            return 1
        fi
    fi
    
    log "SUCCESS" "Repository integrity check passed"
    return 0
}

# Create backup of git objects
create_backup() {
    if [[ "${ENABLE_BACKUPS}" != "true" ]]; then
        log "INFO" "Backups disabled, skipping..."
        return 0
    fi
    
    local backup_name="backup-$(date +%Y%m%d-%H%M%S)-$$"
    local backup_path="${BACKUP_DIR}/${backup_name}"
    
    log "INFO" "Creating backup: ${backup_name}"
    
    # Create backup directory
    mkdir -p "${backup_path}"
    
    # Backup critical git components
    if [[ -d "${REPO_ROOT}/.git/objects" ]]; then
        cp -r "${REPO_ROOT}/.git/objects" "${backup_path}/" 2>/dev/null || true
    fi
    
    if [[ -d "${REPO_ROOT}/.git/refs" ]]; then
        cp -r "${REPO_ROOT}/.git/refs" "${backup_path}/" 2>/dev/null || true
    fi
    
    if [[ -f "${REPO_ROOT}/.git/HEAD" ]]; then
        cp "${REPO_ROOT}/.git/HEAD" "${backup_path}/" 2>/dev/null || true
    fi
    
    if [[ -f "${REPO_ROOT}/.git/index" ]]; then
        cp "${REPO_ROOT}/.git/index" "${backup_path}/" 2>/dev/null || true
    fi
    
    # Cleanup old backups
    cleanup_old_backups
    
    log "SUCCESS" "Backup created: ${backup_name}"
}

# Cleanup old backups
cleanup_old_backups() {
    local backup_count=$(find "${BACKUP_DIR}" -type d -name "backup-*" | wc -l)
    
    if [[ $backup_count -gt $MAX_BACKUPS ]]; then
        log "INFO" "Cleaning up old backups (keeping ${MAX_BACKUPS})"
        find "${BACKUP_DIR}" -type d -name "backup-*" | sort | head -n -${MAX_BACKUPS} | xargs rm -rf
    fi
}

# Detect corruption and attempt recovery
detect_and_recover() {
    if [[ "${ENABLE_CORRUPTION_DETECTION}" != "true" ]]; then
        return 0
    fi
    
    log "INFO" "Checking for corruption after operation..."
    
    # Basic corruption detection
    local corruption_detected=false
    
    # Check for common corruption indicators
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
        log "ERROR" "HEAD corruption detected"
        corruption_detected=true
    fi
    
    if ! git status --porcelain >/dev/null 2>&1; then
        log "ERROR" "Index corruption detected"
        corruption_detected=true
    fi
    
    # Check for pack file corruption
    if find "${REPO_ROOT}/.git/objects/pack" -name "*.pack" -size -1000c 2>/dev/null | grep -q .; then
        log "ERROR" "Corrupt pack files detected"
        corruption_detected=true
    fi
    
    if [[ "$corruption_detected" == "true" ]]; then
        log "ERROR" "Repository corruption detected!"
        offer_recovery
        return 1
    fi
    
    log "SUCCESS" "No corruption detected"
    return 0
}

# Offer recovery options
offer_recovery() {
    log "WARN" "Attempting automatic recovery..."
    
    # Try to recover from most recent backup
    local latest_backup=$(find "${BACKUP_DIR}" -type d -name "backup-*" | sort | tail -n 1)
    
    if [[ -n "$latest_backup" && -d "$latest_backup" ]]; then
        log "INFO" "Found backup: $(basename "$latest_backup")"
        echo -e "${YELLOW}Do you want to restore from backup? (y/N):${NC} "
        read -r response
        
        if [[ "$response" =~ ^[Yy]$ ]]; then
            restore_from_backup "$latest_backup"
        fi
    else
        log "WARN" "No backups available for automatic recovery"
        log "INFO" "Manual recovery steps:"
        log "INFO" "1. Run 'git fsck --full' to identify corruption"
        log "INFO" "2. Run 'git gc --aggressive' to rebuild objects"
        log "INFO" "3. If that fails, clone fresh repository"
    fi
}

# Restore from backup
restore_from_backup() {
    local backup_path="$1"
    
    log "INFO" "Restoring from backup: $(basename "$backup_path")"
    
    # Backup current state first
    local emergency_backup="${BACKUP_DIR}/emergency-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$emergency_backup"
    cp -r "${REPO_ROOT}/.git/objects" "$emergency_backup/" 2>/dev/null || true
    
    # Restore from backup
    if [[ -d "${backup_path}/objects" ]]; then
        rm -rf "${REPO_ROOT}/.git/objects"
        cp -r "${backup_path}/objects" "${REPO_ROOT}/.git/"
    fi
    
    if [[ -d "${backup_path}/refs" ]]; then
        rm -rf "${REPO_ROOT}/.git/refs"
        cp -r "${backup_path}/refs" "${REPO_ROOT}/.git/"
    fi
    
    if [[ -f "${backup_path}/HEAD" ]]; then
        cp "${backup_path}/HEAD" "${REPO_ROOT}/.git/"
    fi
    
    if [[ -f "${backup_path}/index" ]]; then
        cp "${backup_path}/index" "${REPO_ROOT}/.git/"
    fi
    
    log "SUCCESS" "Repository restored from backup"
    log "INFO" "Emergency backup saved to: $(basename "$emergency_backup")"
}

# Main execution function
execute_git_command() {
    local git_command="$1"
    shift
    local git_args="$*"
    
    log "INFO" "Executing: git $git_command $git_args"
    
    # Determine if this is a risky operation
    local is_risky=false
    local needs_quick_check=false
    
    if echo "$git_command" | grep -qE "${RISKY_OPERATIONS}"; then
        is_risky=true
        log "WARN" "Risky operation detected: $git_command"
    fi
    
    if echo "$git_command" | grep -qE "${QUICK_CHECK_OPERATIONS}"; then
        needs_quick_check=true
    fi
    
    # Pre-operation integrity check
    if [[ "${ENABLE_INTEGRITY_CHECKS}" == "true" ]]; then
        if [[ "$is_risky" == "true" ]]; then
            if ! check_integrity false; then
                log "ERROR" "Pre-operation integrity check failed"
                return 1
            fi
        elif [[ "$needs_quick_check" == "true" ]]; then
            if ! check_integrity true; then
                log "ERROR" "Pre-operation quick check failed"
                return 1
            fi
        fi
    fi
    
    # Create backup for risky operations
    if [[ "$is_risky" == "true" ]]; then
        create_backup
    fi
    
    # Execute the git command
    local start_time=$(date +%s)
    git "$git_command" "$@"
    local exit_code=$?
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    if [[ $exit_code -eq 0 ]]; then
        log "SUCCESS" "Git command completed successfully (${duration}s)"
    else
        log "ERROR" "Git command failed with exit code: $exit_code (${duration}s)"
        return $exit_code
    fi
    
    # Post-operation corruption detection
    detect_and_recover
    
    return $exit_code
}

# Help function
show_help() {
    cat << 'EOF'
Git-Safe: Corruption Prevention Wrapper for Git Operations

Usage: git-safe <command> [args...]
       git-safe --init          Initialize git-safe in current repository
       git-safe --status        Show git-safe status and configuration
       git-safe --clean         Clean up old backups and logs
       git-safe --help          Show this help

Examples:
  git-safe commit -m "Safe commit"
  git-safe push origin main
  git-safe rebase -i HEAD~3

Configuration:
  Edit .git/git-safe.conf to customize behavior

Features:
  ✓ Exclusive operation locking (prevents concurrent git operations)
  ✓ Pre-operation integrity checks
  ✓ Automatic backups before risky operations
  ✓ Post-operation corruption detection
  ✓ Automatic recovery suggestions
  ✓ Comprehensive logging

EOF
}

# Status function
show_status() {
    echo -e "${BLUE}=== Git-Safe Status ===${NC}"
    echo "Repository: $(basename "${REPO_ROOT}")"
    echo "Lock file: ${LOCK_FILE}"
    echo "Log file: ${LOG_FILE}"
    echo "Backup directory: ${BACKUP_DIR}"
    echo
    
    if [[ -f "${LOCK_FILE}" ]]; then
        echo -e "${YELLOW}Status: LOCKED${NC}"
        echo "Lock info: $(cat "${LOCK_FILE}")"
    else
        echo -e "${GREEN}Status: AVAILABLE${NC}"
    fi
    
    echo
    echo -e "${BLUE}Configuration:${NC}"
    load_config
    echo "Backups enabled: ${ENABLE_BACKUPS}"
    echo "Integrity checks enabled: ${ENABLE_INTEGRITY_CHECKS}"
    echo "Corruption detection enabled: ${ENABLE_CORRUPTION_DETECTION}"
    echo "Max backups: ${MAX_BACKUPS}"
    
    echo
    echo -e "${BLUE}Statistics:${NC}"
    local backup_count=$(find "${BACKUP_DIR}" -type d -name "backup-*" 2>/dev/null | wc -l || echo "0")
    local log_lines=$(wc -l < "${LOG_FILE}" 2>/dev/null || echo "0")
    echo "Backups: ${backup_count}"
    echo "Log entries: ${log_lines}"
    
    if [[ -f "${LOG_FILE}" ]]; then
        echo
        echo -e "${BLUE}Recent activity:${NC}"
        tail -5 "${LOG_FILE}" 2>/dev/null || echo "No recent activity"
    fi
}

# Clean function
clean_old_files() {
    echo -e "${BLUE}Cleaning up git-safe files...${NC}"
    
    # Clean old backups
    cleanup_old_backups
    
    # Rotate log file if it's too large
    if [[ -f "${LOG_FILE}" && $(stat -f%z "${LOG_FILE}" 2>/dev/null || stat -c%s "${LOG_FILE}" 2>/dev/null || echo "0") -gt 1048576 ]]; then
        log "INFO" "Rotating large log file"
        mv "${LOG_FILE}" "${LOG_FILE}.old"
        touch "${LOG_FILE}"
    fi
    
    echo -e "${GREEN}Cleanup completed${NC}"
}

# Main script logic
main() {
    # Handle special commands
    case "${1:-}" in
        "--init")
            initialize
            exit 0
            ;;
        "--status")
            load_config
            show_status
            exit 0
            ;;
        "--clean")
            load_config
            clean_old_files
            exit 0
            ;;
        "--help"|"-h"|"help")
            show_help
            exit 0
            ;;
        "")
            log "ERROR" "No git command specified"
            show_help
            exit 1
            ;;
    esac
    
    # Load configuration
    load_config
    
    # Set up cleanup trap
    trap cleanup EXIT INT TERM
    
    # Acquire lock and execute
    acquire_lock "$@"
    execute_git_command "$@"
}

# Run main function with all arguments
main "$@"