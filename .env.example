# Environment Variables Template
# Copy this to .env.local for local development

# Required - Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id

# Required - Maps
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Required - AI Assistant
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_UNSTRUCTURED_API_KEY=your_unstructured_api_key_here

# Optional - Payments
VITE_STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx
VITE_STRIPE_LIFETIME_PRICE_ID=price_xxx

# Optional - Development
VITE_ENABLE_DEV_LOGIN=false
VITE_APP_URL=http://localhost:5173

# Note: .env.local is automatically ignored by git
# Never commit actual API keys to version control